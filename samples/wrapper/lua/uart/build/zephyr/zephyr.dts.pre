&pinctrl {
 uart0_default: uart0_default {
  group1 {
   pinmux = <(((28) << 5) | ((2) << 0))>;
  };

  group2 {
   pinmux = <(((29) << 5) | ((2) << 0))>;
   input-enable;
  };
 };

 uart1_default: uart1_default {
  group1 {
   pinmux = <(((20) << 5) | ((2) << 0))>;
  };

  group2 {
   pinmux = <(((21) << 5) | ((2) << 0))>;
   input-enable;
  };
 };

 spi0_default: spi0_default {
  group1 {
   pinmux = <(((34) << 5) | ((1) << 0))>, <(((35) << 5) | ((1) << 0))>;
  };
  group2 {
   pinmux = <(((36) << 5) | ((1) << 0))>;
   input-enable;
  };
 };

 spi1_default: spi1_default {
  group1 {
   pinmux = <(((14) << 5) | ((1) << 0))>, <(((15) << 5) | ((1) << 0))>;
  };
  group2 {
   pinmux = <(((12) << 5) | ((1) << 0))>;
   input-enable;
  };
 };

 i2c0_default: i2c0_default {
  group1 {
   pinmux = <(((4) << 5) | ((3) << 0))>, <(((5) << 5) | ((3) << 0))>;
   input-enable;
   input-schmitt-enable;
   bias-pull-up;
  };
 };

 adc_default: adc_default {
  group1 {
   pinmux = <(((40) << 5) | ((0x1f) << 0))>, <(((42) << 5) | ((0x1f) << 0))>, <(((43) << 5) | ((0x1f) << 0))>;
   input-enable;
  };
 };

 pwm_default: pwm_default {
  group1 {
   pinmux = <(((31) << 5) | ((4) << 0))>, <(((32) << 5) | ((4) << 0))>;
  };
 };

 pio1_ws2812_default: pio1_ws2812_default {
  group1 {
   pinmux = <(((6) << 5) | ((7) << 0))>;
  };
 };
};
# 14 "/home/joaomatheusnd/repo/ufal/zbook_workspace/zbook/boards/zbook/zbook_rp2350b_m33-common.dtsi" 2

/ {
 model = "zbook";
 compatible = "edge,zbook";

 chosen {
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
  zephyr,console = &uart0;
  zephyr,shell-uart = &uart0;
  zephyr,settings-partition = &storage_partition;
 };

 aliases {
  led0 = &blue_led;
  led1 = &green_led;
  led2 = &yellow_led;
  led3 = &red_led;
  button0 = &button1;
  button1 = &button2;
  button2 = &button3;
  button3 = &button4;
  led-strip = &ws2812;
  pwm-buzzer = &pwm_buzzer;
  pwm-mosfet = &pwm_mosfet;
  zbook-uart = &uart1;
 };
# 50 "/home/joaomatheusnd/repo/ufal/zbook_workspace/zbook/boards/zbook/zbook_rp2350b_m33-common.dtsi"
 fstab {
  compatible = "zephyr,fstab";

  lfs_storage: lfs_storage {
   compatible = "zephyr,fstab,littlefs";
   mount-point = "/lfs";
   partition = <&storage_partition>;
   automount;
   read-size = <16>;
   prog-size = <16>;
   cache-size = <64>;
   lookahead-size = <32>;
   block-cycles = <512>;
  };
 };

 leds {
  compatible = "gpio-leds";

  blue_led: blue {
   gpios = <&gpio0 0 (1 << 0)>;
  };

  green_led: green {
   gpios = <&gpio0 1 (1 << 0)>;
  };

  yellow_led: yellow {
   gpios = <&gpio0 2 (1 << 0)>;
  };

  red_led: red {
   gpios = <&gpio0 3 (1 << 0)>;
  };
 };

 buttons {
  compatible = "gpio-keys";

  button1: button1 {
   label = "BTN_UP";
   gpios = <&gpio0 22 (1 << 0)>;
  };

  button2: button2 {
   label = "BTN_RIGHT";
   gpios = <&gpio0 24 (1 << 0)>;
  };

  button3: button3 {
   label = "BTN_LEFT";
   gpios = <&gpio0 25 (1 << 0)>;
  };

  button4: button4 {
   label = "BTN_DOWN";
   gpios = <&gpio0 23 (1 << 0)>;
  };
 };

 microphone: microphone {
  compatible = "voltage-divider";
  io-channels = <&adc 0>;
  output-ohms = <15000>;
  full-ohms = <285000>;
 };
# 125 "/home/joaomatheusnd/repo/ufal/zbook_workspace/zbook/boards/zbook/zbook_rp2350b_m33-common.dtsi"
 zephyr,user {
  io-channels = <&adc 2>, <&adc 3>;
 };

 pico_header: connector {
  compatible = "raspberrypi,pico-header";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &gpio0 0 0>,
  <7 0 &gpio0 7 0>,
  <8 0 &gpio0 8 0>,
  <26 0 &gpio0 26 0>,
  <27 0 &gpio0 27 0>,
  <41 0 &gpio0_hi 9 0>,
  <44 0 &gpio0_hi 12 0>,
  <45 0 &gpio0_hi 13 0>,
  <46 0 &gpio0_hi 14 0>,
  <47 0 &gpio0_hi 15 0>;
 };

 pwm_outputs {
  compatible = "pwm-leds";

  pwm_buzzer: pwm_buzzer_node {
   pwms = <&pwm 16 ((500) * 1000UL) (0 << 0)>;
  };

  pwm_mosfet: pwm_mosfet_node {
   pwms = <&pwm 15 (((20) * 1000UL) * 1000UL) (0 << 0)>;
  };
 };

 spibb0: spibb0 {
  compatible = "zephyr,spi-bitbang";
  status = "okay";
  #address-cells = <1>;
  #size-cells = <0>;

  clk-gpios = <&gpio0 14 (0 << 0)>;
  mosi-gpios = <&gpio0 15 (0 << 0)>;
  cs-gpios = <&gpio0 10 (1 << 0)>;

  display_spi: display_spi@0 {
   compatible = "vnd,spi-device";

   reg = <0>;
   spi-max-frequency = <1600000>;
   label = "OLED Display";
  };
 };
};

&spi0 {
 pinctrl-0 = <&spi0_default>;
 cs-gpios = <&gpio0_hi 7 (1 << 0)>;
 pinctrl-names = "default";

 status = "okay";
 sdhc0: sdhc@0 {
  compatible = "zephyr,sdhc-spi-slot";
  reg = <0>;
  status = "okay";
  mmc {
   compatible = "zephyr,sdmmc-disk";
   disk-name = "SD";
   status = "okay";
  };
  spi-max-frequency = <24000000>;
 };
};

&spi1 {
 pinctrl-0 = <&spi1_default>;
 pinctrl-names = "default";

 cs-gpios = <&gpio0 13 (1 << 0)>;

 status = "okay";
};

&flash0 {
 reg = <0x10000000 (((2) * 1024) * 1024)>;
};

&i2c0 {
 clock-frequency = <100000>;
 pinctrl-0 = <&i2c0_default>;
 pinctrl-names = "default";
 status = "okay";
};

&gpio0 {
 status = "okay";

 actuators {
  compatible = "gpio-leds";

  ir_emitter: ir_emitter {
   gpios = <&gpio0 29 (1 << 0)>;
   label = "IR Emitter";
  };
 };

 accelerometer {
  compatible = "gpio-keys";

  int1: int1 {
   gpios = <&gpio0 16 (0 << 0)>;
   label = "Accelerometer INT1";
  };

  int2: int2 {
   gpios = <&gpio0 17 (0 << 0)>;
   label = "Accelerometer INT2";
  };
 };

 display {
  compatible = "gpio-leds";

  display_reset: display_reset {
   gpios = <&gpio0 11 (0 << 0)>;
   label = "Display Reset";
  };

  display_en: display_en {
   gpios = <&gpio0 9 (0 << 0)>;
   label = "Display Enable";
  };
 };
};

&uart0 {
 status = "okay";
 current-speed = <115200>;
 pinctrl-0 = <&uart0_default>;
 pinctrl-names = "default";
};

&uart1 {
 status = "okay";
 current-speed = <115200>;
 pinctrl-0 = <&uart1_default>;
 pinctrl-names = "default";

};

&adc {
 status = "okay";
 #address-cells = <1>;
 #size-cells = <0>;

 pinctrl-0 = <&adc_default>;
 pinctrl-names = "default";

 potentiometer: channel@0 {
  reg = <0>;
  zephyr,gain = "ADC_GAIN_1";
  zephyr,reference = "ADC_REF_INTERNAL";
  zephyr,acquisition-time = <0>;
  zephyr,resolution = <12>;
 };

 ldr_adc: channel@2 {
  reg = <2>;
  zephyr,gain = "ADC_GAIN_1";
  zephyr,reference = "ADC_REF_INTERNAL";
  zephyr,acquisition-time = <0>;
  zephyr,resolution = <12>;
 };

 channel@3 {
  reg = <3>;
  zephyr,gain = "ADC_GAIN_1";
  zephyr,reference = "ADC_REF_INTERNAL";
  zephyr,acquisition-time = <0>;
  zephyr,resolution = <12>;
 };
};

&pio1 {
 status = "okay";





 pio_ws2812: ws2812 {
  compatible = "worldsemi,ws2812-rpi_pico-pio";
  status = "okay";
  pinctrl-0 = <&pio1_ws2812_default>;
  pinctrl-names = "default";
  bit-waveform = <3>, <3>, <4>;

  ws2812: ws2812 {
   status = "okay";
   gpios = <&gpio0 6 (0 << 0)>;
   chain-length = <1>;
   color-mapping = <2
   1
   3>;
   reset-delay = <280>;
   frequency = <800000>;
  };
 };
};

&pwm {
 status = "okay";
 pinctrl-0 = <&pwm_default>;
 pinctrl-names = "default";
 divider-int-0 = <255>;
};

&gpio0_hi {
 status = "okay";

 sensors {
  compatible = "gpio-keys";

  ir_receiver: ir-receiver {
   gpios = <&gpio0_hi 1 (0 << 0)>;
   label = "IR Receiver";
  };
 };
};

&rng {
 status = "okay";
};
# 16 "/home/joaomatheusnd/repo/ufal/zbook_workspace/zbook/boards/zbook/zbook_rp2350b_m33.dts" 2

/ {
 chosen {
  zephyr,code-partition = &code_partition;
 };
};

&flash0 {
 partitions {
  compatible = "fixed-partitions";
  #address-cells = <1>;
  #size-cells = <1>;

  image_def: partition@0 {
   label = "image_def";
   reg = <0x00000000 0x100>;
   read-only;
  };






  code_partition: partition@100 {
   label = "code-partition";
   reg = <0x100 ((((2) * 1024) * 1024) - 0x100 - ((256) * 1024))>;
   read-only;
  };


  storage_partition: partition@1c0000 {
   label = "storage";
   reg = <((((2) * 1024) * 1024) - ((256) * 1024)) ((256) * 1024)>;
  };
 };
};
