menu "ZBook language wrappers"
	depends on LUA

config ZBOOK_LUA_UART
	bool "Lua binding for zbook_uart"
	default y
	help
	  Expose zbook_uart_* to Lua scripts as zbook.protocols.uart.

endmenu
