/ {
 aliases {
  die-temp0 = &die_temp;
 };

 chosen {
  zephyr,entropy = &rng;
 };

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;






  cpu0: cpu@0 {
   reg = <0>;
  };

  cpu1: cpu@1 {
   reg = <1>;
  };
 };

 clocks {
  clk_gpout0: clk-gpout0 {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_sys>;
   clock-names = "pll_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
   #address-cells = <0>;
  };

  clk_gpout1: clk-gpout1 {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_sys>;
   clock-names = "pll_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
  };

  clk_gpout2: clk-gpout2 {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_sys>;
   clock-names = "pll_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
  };

  clk_gpout3: clk-gpout3 {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_sys>;
   clock-names = "pll_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
  };

  clk_hstx: clk-hstx {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_sys>;
   clock-names = "pll_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
  };

  clk_ref: clk-ref {
   compatible = "raspberrypi,pico-clock";
   clocks = <&xosc>;
   clock-names = "xosc";
   clock-frequency = <12000000>;
   #clock-cells = <0>;
  };

  clk_sys: clk-sys {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_sys>;
   clock-names = "pll_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
  };

  clk_usb: clk-usb {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_usb>;
   clock-names = "pll_usb";
   clock-frequency = <48000000>;
   #clock-cells = <0>;
  };

  clk_adc: clk-adc {
   compatible = "raspberrypi,pico-clock";
   clocks = <&pll_usb>;
   clock-names = "pll_usb";
   clock-frequency = <48000000>;
   #clock-cells = <0>;
  };

  clk_peri: clk-peri {
   compatible = "raspberrypi,pico-clock";
   clocks = <&clk_sys>;
   clock-names = "clk_sys";
   clock-frequency = <150000000>;
   #clock-cells = <0>;
  };

  pll_sys: pll-sys {
   compatible = "raspberrypi,pico-pll";
   clocks = <&xosc>;
   clock-names = "xosc";
   clock-div = <1>;
   fb-div = <125>;
   post-div1 = <5>;
   post-div2 = <2>;
   #clock-cells = <0>;
  };

  pll_usb: pll-usb {
   compatible = "raspberrypi,pico-pll";
   clocks = <&xosc>;
   clock-names = "xosc";
   clock-div = <1>;
   fb-div = <100>;
   post-div1 = <5>;
   post-div2 = <5>;
   #clock-cells = <0>;
  };

  rosc: rosc {
   compatible = "raspberrypi,pico-rosc";
   clock-frequency = <6500000>;
   range = <0xAA0>;
   stage-drive-strength = <0>, <0>, <0>, <0>, <0>, <0>, <0>, <0>;
   clock-div = <16>;
   phase = <0>;
   #clock-cells = <0>;
  };

  rosc_ph: rosc-ph {
   compatible = "raspberrypi,pico-clock";
   clock-frequency = <6500000>;
   clocks = <&rosc>;
   clock-names = "rosc";
   #clock-cells = <0>;
  };

  xosc: xosc {
   compatible = "raspberrypi,pico-xosc";
   clock-frequency = <12000000>;
   #clock-cells = <0>;
  };

  gpin0: gpin0 {
   compatible = "raspberrypi,pico-clock";
   status = "disabled";
   clock-frequency = <0>;
   #clock-cells = <0>;
  };

  gpin1: gpin1 {
   compatible = "raspberrypi,pico-clock";
   status = "disabled";
   clock-frequency = <0>;
   #clock-cells = <0>;
  };
 };

 soc {
  compatible = "raspberrypi,rp2350", "simple-bus";

  sram0: memory@20000000 {
   compatible = "mmio-sram";
   reg = <0x20000000 ((520) * 1024)>;
  };

  qmi: flash-controller@400d0000 {
   compatible = "raspberrypi,pico-flash-controller";
   reg = <0x400d0000 0x54>;

   #address-cells = <1>;
   #size-cells = <1>;

   flash0: flash@10000000 {
    compatible = "soc-nv-flash";
    write-block-size = <1>;
    erase-block-size = <((4) * 1024)>;
   };
  };

  reset: reset-controller@40020000 {
   compatible = "raspberrypi,pico-reset";
   reg = <0x40020000 ((4) * 1024)>;
   #reset-cells = <1>;
  };

  clocks: clock-controller@40010000 {
   compatible = "raspberrypi,pico-clock-controller";
   reg = <0x40010000 ((4) * 1024)
          0x40048000 ((4) * 1024)
          0x40050000 ((4) * 1024)
          0x40058000 ((4) * 1024)
          0x400e8000 ((4) * 1024)>;
   reg-names = "clocks", "xosc", "pll_sys", "pll_usb", "rosc";
   #clock-cells = <1>;
   status = "okay";
   clocks = <&clk_gpout0>, <&clk_gpout1>, <&clk_gpout2>, <&clk_gpout3>,
     <&clk_hstx>, <&clk_ref>, <&clk_sys>, <&clk_peri>,
     <&clk_usb>, <&clk_adc>,
     <&pll_sys>, <&pll_usb>, <&xosc>, <&rosc>, <&rosc_ph>,
     <&gpin0>, <&gpin1>;
   clock-names = "clk_gpout0", "clk_gpout1", "clk_gpout2", "clk_gpout3",
          "clk_hstx", "clk_ref", "clk_sys", "clk_peri",
          "clk_usb", "clk_adc",
          "pll_sys", "pll_usb", "xosc", "rosc", "rosc_ph",
          "gpin0", "gpin1";
  };

  gpio0_map: gpio@40028000 {
   compatible = "raspberrypi,pico-gpio";
   reg = <0x40028000 ((4) * 1024)>;
   interrupts = <21 7>;

   gpio-map-mask = <0xffffffe0 0xffffffc0>;
   gpio-map-pass-thru = <0x1f 0x3f>;
   gpio-map = <0x00 0x0 &gpio0 0x0 0x0
        0x20 0x0 &gpio0_hi 0x0 0x0>;
   #gpio-cells = <2>;
   #address-cells = <1>;
   #size-cells = <0>;

   gpio0: gpio-port@0 {
    compatible = "raspberrypi,pico-gpio-port";
    reg = <0x0>;
    status = "disabled";
    gpio-controller;
    #gpio-cells = <2>;
    ngpios = <32>;
   };

   gpio0_hi: gpio-port@1 {
    compatible = "raspberrypi,pico-gpio-port";
    reg = <0x1>;
    status = "disabled";
    gpio-controller;
    #gpio-cells = <2>;
    ngpios = <32>;
   };
  };

  uart0: uart@40070000 {
   compatible = "raspberrypi,pico-uart", "arm,pl011";
   reg = <0x40070000 ((4) * 1024)>;
   clocks = <&clocks 6>;
   resets = <&reset 26>;
   interrupts = <33 7>;
   interrupt-names = "uart0";
   status = "disabled";
  };

  uart1: uart@40078000 {
   compatible = "raspberrypi,pico-uart", "arm,pl011";
   reg = <0x40078000 ((4) * 1024)>;
   clocks = <&clocks 6>;
   resets = <&reset 27>;
   interrupts = <34 7>;
   interrupt-names = "uart1";
   status = "disabled";
  };

  spi0: spi@40080000 {
   compatible = "raspberrypi,pico-spi", "arm,pl022";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x40080000 ((4) * 1024)>;
   clocks = <&clocks 6>;
   resets = <&reset 18>;
   interrupts = <31 7>;
   interrupt-names = "spi0";
   status = "disabled";
  };

  spi1: spi@40088000 {
   compatible = "raspberrypi,pico-spi", "arm,pl022";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x40088000 ((4) * 1024)>;
   resets = <&reset 19>;
   clocks = <&clocks 6>;
   interrupts = <32 7>;
   interrupt-names = "spi1";
   status = "disabled";
  };

  i2c0: i2c@40090000 {
   compatible = "raspberrypi,pico-i2c", "snps,designware-i2c";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x40090000 ((4) * 1024)>;
   resets = <&reset 4>;
   clocks = <&clocks 5>;
   interrupts = <36 7>;
   interrupt-names = "i2c0";
   status = "disabled";
  };

  i2c1: i2c@40098000 {
   compatible = "raspberrypi,pico-i2c", "snps,designware-i2c";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0x40098000 ((4) * 1024)>;
   resets = <&reset 5>;
   clocks = <&clocks 5>;
   interrupts = <37 7>;
   interrupt-names = "i2c1";
   status = "disabled";
  };

  adc: adc@400a0000 {
   compatible = "raspberrypi,pico-adc";
   reg = <0x400a0000 ((4) * 1024)>;
   resets = <&reset 0>;
   clocks = <&clocks 9>;
   interrupts = <35 7>;
   interrupt-names = "adc0";
   status = "disabled";
   #io-channel-cells = <1>;
  };

  pwm: pwm@400a8000 {
   compatible = "raspberrypi,pico-pwm";
   reg = <0x400a8000 ((4) * 1024)>;
   resets = <&reset 16>;
   clocks = <&clocks 5>;
   interrupts = <8 7>,
         <9 7>;
   interrupt-names = "PWM_IRQ_WRAP_0",
       "PWM_IRQ_WRAP_1";
   status = "disabled";
   #pwm-cells = <3>;
  };

  timer0: timer@400b0000 {
   compatible = "raspberrypi,pico-timer";
   reg = <0x400b0000 ((4) * 1024)>;
   resets = <&reset 23>;
   clocks = <&clocks 4>;
   interrupts = <0 7>,
         <1 7>,
         <2 7>,
         <3 7>;
   interrupt-names = "TIMER0_IRQ_0",
       "TIMER0_IRQ_1",
       "TIMER0_IRQ_2",
       "TIMER0_IRQ_3";
   status = "disabled";
  };

  timer1: timer@400b8000 {
   compatible = "raspberrypi,pico-timer";
   reg = <0x400b8000 ((4) * 1024)>;
   resets = <&reset 24>;
   clocks = <&clocks 4>;
   interrupts = <4 7>,
         <5 7>,
         <6 7>,
         <7 7>;
   interrupt-names = "TIMER1_IRQ_0",
       "TIMER1_IRQ_1",
       "TIMER1_IRQ_2",
       "TIMER1_IRQ_3";
   status = "disabled";
  };

  wdt0: watchdog@400d8000 {
   compatible = "raspberrypi,pico-watchdog";
   reg = <0x400d8000 ((4) * 1024)>;
   clocks = <&clocks 4>;
   status = "disabled";
  };

  sha256: sha256@400f8000 {
   compatible = "raspberrypi,pico-sha256";
   reg = <0x400f8000 0x200>;
   status = "disabled";
  };

  vreg: vreg@40100000 {
   compatible = "raspberrypi,core-supply-regulator";
   reg = <0x40100000 0x200>;
   status = "okay";
   raspberrypi,brown-out-detection;
  };

  dma: dma@50000000 {
   compatible = "raspberrypi,pico-dma";
   reg = <0x50000000 ((64) * 1024)>;
   resets = <&reset 2>;
   clocks = <&clocks 5>;
   interrupts = <10 7>,
         <11 7>,
         <12 7>,
         <13 7>;
   interrupt-names = "dma0", "dma1", "dma2", "dma3";
   dma-channels = <16>;
   status = "disabled";
   #dma-cells = <3>;
  };

  usbd: usbd@50110000 {
   compatible = "raspberrypi,pico-usbd";
   reg = <0x50110000 0x10000>;
   resets = <&reset 28>;
   clocks = <&clocks 8>;
   interrupts = <14 7>;
   interrupt-names = "usbctrl";
   num-bidir-endpoints = <16>;
   status = "disabled";
  };

  pio0: pio@50200000 {
   compatible = "raspberrypi,pico-pio";
   reg = <0x50200000 ((4) * 1024)>;
   clocks = <&clocks 5>;
   resets = <&reset 11>;
   interrupts = <15 7>,
         <16 7>;
   interrupt-names = "irq0", "irq1";
   status = "disabled";
  };

  pio1: pio@50300000 {
   compatible = "raspberrypi,pico-pio";
   reg = <0x50300000 ((4) * 1024)>;
   clocks = <&clocks 5>;
   resets = <&reset 12>;
   interrupts = <17 7>,
         <18 7>;
   interrupt-names = "irq0", "irq1";
   status = "disabled";
  };

  pio2: pio@50400000 {
   compatible = "raspberrypi,pico-pio";
   reg = <0x50400000 ((4) * 1024)>;
   clocks = <&clocks 5>;
   resets = <&reset 13>;
   interrupts = <19 7>,
         <20 7>;
   interrupt-names = "irq0", "irq1";
   status = "disabled";
  };

  rng: rng@400f0000 {
   compatible = "raspberrypi,pico-rng";
   reg = <0x400f0000 ((4) * 1024)>;
   status = "disabled";
  };

  sio: sio@d0000000 {
   compatible = "raspberrypi,pico-sio";
   reg = <0xd0000000 ((80) * 1024)>;

   mbox: mbox {
    compatible = "raspberrypi,pico-mbox";
    interrupts = <25 7>;
    interrupt-names = "mbox0";
    fifo-depth = <4>;
    #mbox-cells = <0>;
    status = "disabled";
   };
  };
 };

 ipm_mbox: ipm-mbox {






  compatible = "zephyr,mbox-ipm";
  mboxes = <&mbox>, <&mbox>;
  mbox-names = "tx", "rx";
  status = "disabled";
 };

 pinctrl: pin-controller {
  compatible = "raspberrypi,pico-pinctrl";
  status = "okay";
 };

 die_temp: dietemp {
  compatible = "raspberrypi,pico-temp";
  status = "disabled";
 };
};
